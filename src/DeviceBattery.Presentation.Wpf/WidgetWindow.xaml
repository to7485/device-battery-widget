<Window x:Class="DeviceBattery.Presentation.Wpf.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Battery Widget" Width="360" Height="148" MinWidth="330" MinHeight="138" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" FontFamily="Segoe UI Variable Text" FontSize="12"
        Topmost="{Binding IsTopmost}" Background="Transparent" Foreground="#101522">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="DualSenseGauge" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/><Setter Property="Maximum" Value="100"/><Setter Property="Foreground" Value="#2864F0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid>
                <Border Background="#DCE2EC" CornerRadius="4"/>
                <Border x:Name="PART_Track" Background="Transparent" CornerRadius="4"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/></Border>
            </Grid></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsCharging}" Value="True"><Setter Property="Foreground" Value="#4ACB82"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#6E7789"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E1E7F2"/><Setter Property="Foreground" Value="#101522"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="8" CornerRadius="18" BorderThickness="1" BorderBrush="#B9C8EA">
        <Border.Effect><DropShadowEffect Color="#183B88" BlurRadius="18" ShadowDepth="3" Opacity="0.24"/></Border.Effect>
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F0F3F8" Offset="1"/></LinearGradientBrush></Border.Background>
        <Grid Margin="16,12">
            <Border Background="#111725" CornerRadius="13" Padding="16,13" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="컨트롤러 연결 대기 중" Foreground="#F4F7FC" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Bluetooth 또는 USB 연결을 확인해 주세요" Foreground="#98A4B8" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="False"><Button Content="×" DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Margin="8,-3,-3,0" Click="OnCloseClick" ToolTip="종료"/></DockPanel>
                <DockPanel Grid.Row="1" Margin="0,5,0,0" LastChildFill="True"><TextBlock Text="{Binding BatteryText}" DockPanel.Dock="Right" FontSize="17" FontWeight="Bold" Foreground="#101522" Margin="9,0,0,0"/><TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#202738" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
                <Grid Grid.Row="2" Margin="0,9,0,7">
                    <ProgressBar Value="{Binding GaugePercent, Mode=OneWay}" Style="{StaticResource DualSenseGauge}"/>
                    <TextBlock Text="⚡" FontSize="10" FontWeight="Bold" Foreground="#17633C"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsCharging, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#667085"/><Style.Triggers><DataTrigger Binding="{Binding IsCharging}" Value="True"><Setter Property="Foreground" Value="#23965A"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Grid>
    </Border>
</Window>
